generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- AUTH & RBAC ----------------
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  image        String?
  phone        String?
  address      String?
  bio          String?
  dob          DateTime?
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paymentsReceived Payment[]    @relation("ReceivedBy")
  auditLogs        AuditLog[]   
}

model Role {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())
}

// ---------------- CLIENT ----------------
model Client {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  email         String?
  address       String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  serviceOrders ServiceOrder[]
  sales         Sale[]         
}

// ---------------- SERVICE ----------------
model Service {
  id          String         @id @default(cuid())
  name        String
  description String?
  price       Decimal        @db.Decimal(12, 2)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  orders      ServiceOrder[]
  saleItems   SaleItem[]
}

enum PaymentType {
  FULL
  INSTALLMENT
}

enum OrderStatus {
  PENDING
  PARTIAL
  PAID
  CANCELLED
}

model ServiceOrder {
  id          String        @id @default(cuid())
  orderNo     String        @unique
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id])
  totalAmount Decimal       @db.Decimal(12, 2)
  paymentType PaymentType
  status      OrderStatus   @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  installments Installment[]
  payments     Payment[]
}

enum InstallmentStatus {
  DUE
  PARTIAL
  PAID
}

model Installment {
  id             String            @id @default(cuid())
  serviceOrderId String
  serviceOrder   ServiceOrder      @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  dueDate        DateTime
  amount         Decimal           @db.Decimal(12, 2)
  paidAmount     Decimal           @default(0) @db.Decimal(12, 2)
  status         InstallmentStatus @default(DUE)
  createdAt      DateTime          @default(now())
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE
}

model PaymentAccount {
  id          String   @id @default(cuid())
  name        String
  type        String   // BANK, MFS, CASH, QR
  accountNo   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  payments       Payment[]
  expenses       Expense[]
  loanRepayments LoanRepayment[]
  sales          Sale[]          
}

model Payment {
  id               String          @id @default(cuid())
  serviceOrderId   String?
  serviceOrder     ServiceOrder?   @relation(fields: [serviceOrderId], references: [id], onDelete: Cascade)
  saleId           String?
  sale             Sale?           @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount           Decimal         @db.Decimal(12, 2)
  method           PaymentMethod   @default(CASH)
  paymentAccountId String?
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id])
  reference        String?
  receivedById     String
  receivedBy       User            @relation("ReceivedBy", fields: [receivedById], references: [id])
  paidAt           DateTime        @default(now())
  notes            String?
  journalEntry     JournalEntry?
}

// ---------------- INVENTORY ----------------
model Distributor {
  id        String     @id @default(cuid())
  name      String
  phone     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  purchases Purchase[]
}

model Product {
  id            String         @id @default(cuid())
  sku           String         @unique
  name          String
  costPrice     Decimal        @db.Decimal(12, 2)
  sellPrice     Decimal        @db.Decimal(12, 2)
  stockQty      Int            @default(0)
  reorderLvl    Int            @default(5)
  isActive      Boolean        @default(true)
  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
}

enum PurchaseStatus {
  PAID
  CREDIT
}

model Purchase {
  id            String         @id @default(cuid())
  distributorId String
  distributor   Distributor    @relation(fields: [distributorId], references: [id])
  total         Decimal        @db.Decimal(12, 2)
  paidAmount    Decimal        @default(0) @db.Decimal(12, 2)
  status        PurchaseStatus @default(CREDIT)
  paymentAccountId String?
  items         PurchaseItem[]
  createdAt     DateTime       @default(now())
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  qty        Int
  unitCost   Decimal  @db.Decimal(12, 2)
}

// ---------------- COMMON SALES ----------------
model Sale {
  id               String          @id @default(cuid())
  invoiceNo        String          @unique
  clientId         String
  client           Client          @relation(fields: [clientId], references: [id])
  total            Decimal         @db.Decimal(12, 2)
  paidAmount       Decimal         @default(0) @db.Decimal(12, 2)
  dueAmount        Decimal         @default(0) @db.Decimal(12, 2)
  discount         Decimal         @default(0) @db.Decimal(12, 2)
  paymentAccountId String?
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id])
  items            SaleItem[]
  payments         Payment[]
  createdAt        DateTime        @default(now())
}

model SaleItem {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemType  String   // "SERVICE" or "PRODUCT"
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  qty       Int
  unitPrice Decimal  @db.Decimal(12, 2)
  discount  Decimal  @default(0) @db.Decimal(12, 2)
}

// ---------------- LOAN ----------------
enum LoanStatus {
  ACTIVE
  CLOSED
}

model Loan {
  id           String          @id @default(cuid())
  lenderName   String
  principal    Decimal         @db.Decimal(12, 2)
  interestRate Decimal         @db.Decimal(5, 2)
  tenureMonths Int
  emiAmount    Decimal         @db.Decimal(12, 2)
  startDate    DateTime
  repayments   LoanRepayment[]
  status       LoanStatus      @default(ACTIVE)
  createdAt    DateTime        @default(now())
}

model LoanRepayment {
  id               String          @id @default(cuid())
  loanId           String
  loan             Loan            @relation(fields: [loanId], references: [id])
  amount           Decimal         @db.Decimal(12, 2)
  paymentAccountId String?
  paymentAccount   PaymentAccount? @relation(fields: [paymentAccountId], references: [id])
  paidAt           DateTime        @default(now())
}

// ---------------- INVESTMENT ----------------
model Investor {
  id          String       @id @default(cuid())
  name        String       @unique
  phone       String?
  email       String?
  address     String?
  createdAt   DateTime     @default(now())
  investments Investment[]
}

model Investment {
  id         String             @id @default(cuid())
  investorId String
  investor   Investor           @relation(fields: [investorId], references: [id])
  amount     Decimal            @db.Decimal(12, 2)
  investedAt DateTime           @default(now())
  returns    InvestmentReturn[]
}

model InvestmentReturn {
  id           String     @id @default(cuid())
  investmentId String
  investment   Investment @relation(fields: [investmentId], references: [id])
  amount       Decimal    @db.Decimal(12, 2)
  paidAt       DateTime   @default(now())
}

// ---------------- ACCOUNTING ----------------
model Account {
  id    String        @id @default(cuid())
  code  String        @unique
  name  String
  type  String        // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  lines JournalLine[]
}

model JournalEntry {
  id        String        @id @default(cuid())
  paymentId String?       @unique
  payment   Payment?      @relation(fields: [paymentId], references: [id])
  memo      String?
  createdAt DateTime      @default(now())
  lines     JournalLine[]
}

model JournalLine {
  id             String       @id @default(cuid())
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0) @db.Decimal(12, 2)
  credit         Decimal      @default(0) @db.Decimal(12, 2)
}

// ---------------- EXPENSE ----------------
model ExpenseCategory {
  id        String          @id @default(cuid())
  name      String          @unique
  heads     ExpenseHead[]
  expenses  Expense[]
  createdAt DateTime        @default(now())
}

model ExpenseHead {
  id         String            @id @default(cuid())
  name       String
  categoryId String
  category   ExpenseCategory   @relation(fields: [categoryId], references: [id])
  subHeads   ExpenseSubHead[]
  expenses   Expense[]
  createdAt  DateTime          @default(now())
}

model ExpenseSubHead {
  id        String       @id @default(cuid())
  name      String
  headId    String
  head      ExpenseHead  @relation(fields: [headId], references: [id])
  expenses  Expense[]
  createdAt DateTime     @default(now())
}

model Expense {
  id               String           @id @default(cuid())
  title            String
  amount           Decimal          @db.Decimal(12, 2)
  
  categoryId       String?
  category         ExpenseCategory? @relation(fields: [categoryId], references: [id])
  
  headId           String?
  head             ExpenseHead?     @relation(fields: [headId], references: [id])
  
  subHeadId        String?
  subHead          ExpenseSubHead?  @relation(fields: [subHeadId], references: [id])
  
  paymentAccountId String?
  paymentAccount   PaymentAccount?  @relation(fields: [paymentAccountId], references: [id])
  
  date             DateTime         @default(now())
  notes            String?
  invoiceNo        String?         
  createdAt        DateTime         @default(now())
}

// ---------------- DIVIDEND ----------------
model ShareHolder {
  id            String          @id @default(cuid())
  name          String
  phone         String?
  email         String?
  totalShares   Int             @default(0)
  createdAt     DateTime        @default(now())
  allocations   ShareAllocation[]
  dividends     Dividend[]
}

model ShareAllocation {
  id            String      @id @default(cuid())
  shareHolderId String
  shareHolder   ShareHolder @relation(fields: [shareHolderId], references: [id])
  shares        Int
  pricePerShare Decimal     @db.Decimal(12, 2)
  allocatedAt   DateTime    @default(now())
}

model Dividend {
  id            String      @id @default(cuid())
  shareHolderId String
  shareHolder   ShareHolder @relation(fields: [shareHolderId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  status        String      @default("PENDING") // PENDING, PAID
  declaredAt    DateTime    @default(now())
  paidAt        DateTime?
}

// ---------------- ACTIVITY LOG ----------------
model ActivityLog {
  id        String   @id @default(cuid())
  type      String
  title     String   
  message   String
  amount    Decimal? @db.Decimal(12, 2)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---------------- COMPANY SETTINGS ----------------
model CompanySettings {
  id            String   @id @default("global_settings")
  companyName   String   @default("ByteFlow & Co.")
  companySub    String   @default("Technologies")
  address       String   @default("123 Tech Street, Dhaka, Bangladesh")
  phone         String   @default("+880 1700-000000")
  email         String   @default("hello@byteflow.com")
  bankName      String   @default("ByteFlow Bank Ltd.")
  accountNumber String   @default("123-456-7890")
  terms         String   @default("Please send payment within 30 days of receiving this invoice. There will be 10% interest charge per month on late invoice.")
  updatedAt     DateTime @updatedAt
}

// ---------------- DASHBOARD SETTINGS ----------------
model DashboardSetting {
  id             String   @id @default("global_dashboard")
  showBank       Boolean  @default(true)
  showMFS        Boolean  @default(true)
  showQR         Boolean  @default(true)
  showCash       Boolean  @default(true)
  showLoan       Boolean  @default(true)
  showLoanPaid   Boolean  @default(true)
  showSale       Boolean  @default(true)
  showInvestment Boolean  @default(true)
  showDue        Boolean  @default(true)
  showStock      Boolean  @default(true)
  showUserCount  Boolean  @default(true)
  showGraph      Boolean  @default(true)
  showDividend   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}